{
  "id": "bambujab",
  "name": "BambuJab",
  "description": "Surveillance et pilotage des imprimantes 3D BambuLab (X1/P1/A1) en LAN ou via le Cloud : états, AMS/filaments, étapes d'impression, caméra live, vignettes, gestion de fichiers et erreurs traduites en clair.",
  "licence": "AGPL v3",
  "author": "Aldarande",
  "require": "4.4.0",
  "category": "devicecommunication",
  "hasDependency": true,
  "hasOwnDeamon": true,
  "maxDependancyInstallTime": 300,
  "pluginVersion": "0.7.7",
  "documentation": "https://aldarande.github.io/bambujab/#language#/index.html",
  "documentation_beta": "https://aldarande.github.io/bambujab/#language#/beta.html",
  "changelog": "https://aldarande.github.io/bambujab/#language#/index.html#changelog",
  "changelog_beta": "https://aldarande.github.io/bambujab/#language#/beta.html#beta-nouveautes",
  "language": [
    "fr_FR",
    "en_US",
    "de_DE",
    "it_IT",
    "es_ES"
  ],
  "compatibility": [
    "smart",
    "luna",
    "atlas",
    "rpi",
    "docker",
    "diy",
    "mobile"
  ],
  "excludeFromBackup": [
    "resources/venv",
    "resources/bambujabd/jeedom/__pycache__",
    "resources/bambujabd/bambu/__pycache__"
  ]
}
